# @plone/volto is a peerDependency supplied by the host Volto app (or, in the
# sitebase-modelo monorepo, by the linked core/packages/volto workspace member).
# When this repo is installed standalone (e.g. in its own CI), don't let pnpm
# fetch the whole Volto core tree just to satisfy that peer.
auto-install-peers=false
